# 站点信息
PORT=3000
SITE_NAME=共享 Apple ID 面板
SITE_URL=http://localhost:3000
SITE_DESCRIPTION=美区、香港区、台湾区 Apple ID 共享账号实时状态展示，密码按需获取、复制即用。

# 数据目录（Docker 部署时对应挂载卷）
DATA_DIR=./data

# true = 首屏 HTML 不输出明文密码，点击「显示密码」才向后端按需请求
# 这是防批量抓取的关键设计，建议保持开启
REVEAL_ON_CLICK=true

# 是否在页面展示账号更新时间
SHOW_UPDATED_AT=true

# 账号列表下方的免责声明
FOOTER_NOTE=共享账号仅供下载被下架应用使用，请勿登录 iCloud，下载完成后请及时退出。
